{
  "name": "@peiyanlu/release",
  "version": "2.0.1",
  "description": "Tool to automate version bumps, changelogs, and releases.",
  "license": "MIT",
  "type": "module",
  "private": false,
  "bin": {
    "release": "index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "tsdown -w",
    "build": "tsdown",
    "prepublishOnly": "tsdown",
    "release": "node index.js",
    "release:dry": "node index.js -C -n",
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@clack/prompts": "^1.8.1",
    "@conventional-changelog/template": "^1.4.0",
    "@octokit/rest": "^22.0.1",
    "@peiyanlu/cli-utils": "^0.0.15",
    "@peiyanlu/node-utils": "^0.0.4",
    "@peiyanlu/ts-utils": "^0.0.12",
    "ansis": "^4.4.0",
    "commander": "^15.0.0",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "conventional-recommended-bump": "^12.1.0",
    "handlebars": "^4.7.10",
    "open": "^11.0.4",
    "publint": "^0.3.25",
    "semver": "^7.8.5",
    "tinyglobby": "^0.2.17",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@peiyanlu/test-tools": "^0.0.7",
    "@types/node": "^24.19.2",
    "@types/semver": "^7.8.0",
    "@vitest/coverage-v8": "^5.0.5",
    "tsdown": "^0.23.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "author": {
    "name": "YanluPei",
    "email": "peiyanlu@vip.qq.com"
  },
  "engines": {
    "node": ">=22.18"
  },
  "keywords": [
    "typescript",
    "cli"
  ],
  "files": [
    "dist",
    "template"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peiyanlu/release.git"
  },
  "bugs": {
    "url": "https://github.com/peiyanlu/release/issues"
  },
  "homepage": "https://github.com/peiyanlu/release#readme"
}
